# SpicyHome POS — environment variable template
#
# Both main and linked worktrees use .env.worktree (gitignored).
# Copy to .env.worktree and fill in real values.
# Never commit real DSNs, tokens, or secrets.
#
# Linked worktrees auto-inherit Sentry DSNs from the main worktree's
# .env.worktree via scripts/worktree/env.sh.
#
# Android reads apps/android/local.properties (gitignored, auto-synced by
# the bootstrap script from SENTRY_ANDROID_DSN below):
#   SENTRY_DSN=<SENTRY_ANDROID_DSN>
#   SENTRY_ENVIRONMENT=<SENTRY_ENVIRONMENT>

# ── Worktree / runtime ──────────────────────────────────────────
PORT=3742
VITE_PORT=6124
INSPECT_PORT=9229
SPICYHOME_DB=./data/spicyhome.db
WORKTREE_SLUG=
TZ=Asia/Riyadh
JWT_SECRET=
SPA_DIST=
MIGRATIONS_DIR=
APP_VERSION=

# ── Server Sentry (runtime) ─────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# ── Android Sentry (bootstrap copies to apps/android/local.properties as SENTRY_DSN) ──
SENTRY_ANDROID_DSN=

# ── SPA Sentry (build-time Vite) ────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_RELEASE=

# ── Source map upload (CI / local release tooling only — never ship token) ──
SENTRY_AUTH_TOKEN=
SENTRY_ORG=spicyhome
SENTRY_PROJECT=
# EU region (ingest.de.sentry.io)
SENTRY_URL=https://de.sentry.io
