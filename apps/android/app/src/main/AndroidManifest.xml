<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SpicyHomeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpicyHome"
        android:usesCleartextTraffic="true">

        <!-- Sentry config (placeholders filled by Gradle). auto-init off → SpicyHomeApp.initSentry. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <meta-data android:name="io.sentry.dsn" android:value="${sentryDsn}" />
        <meta-data android:name="io.sentry.environment" android:value="${sentryEnvironment}" />
        <meta-data android:name="io.sentry.release" android:value="${sentryRelease}" />
        <meta-data android:name="io.sentry.debug" android:value="${sentryDebug}" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="true" />
        <meta-data android:name="io.sentry.traces-sample-rate" android:value="1.0" />
        <meta-data android:name="io.sentry.profiles-sample-rate" android:value="1.0" />
        <meta-data android:name="io.sentry.max-breadcrumbs" android:value="200" />
        <meta-data android:name="io.sentry.attach-stacktrace" android:value="true" />
        <meta-data android:name="io.sentry.max-request-body-size" android:value="always" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.SpicyHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded APK to the system package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
